# SHUOMI-ERP PRIVATE CUSTOMIZATION: production/local deployment
# 本地/测试环境模板：复制为 docker/.env 后修改。生产请使用 .env.prod.example。
# .env 和 .env.prod 不要提交到代码仓库。
#   cp .env.example .env

# 访问端口：浏览器访问 http://服务器地址:WEB_PORT
WEB_BIND_IP=127.0.0.1
WEB_PORT=80

# 数据库与缓存密码（请替换为强密码）
MYSQL_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-db
REDIS_PASSWORD=change-me-redis

# 登录令牌签名密钥，至少 32 字节，可用 openssl rand -base64 48 生成
JWT_SECRET=change-me-please-use-openssl-rand-base64-48

# 加密保存「AI 设置」中 API Key 的密钥（可选，为空时使用 JWT_SECRET）；更换后需要在 AI 设置中重新填写 API Key
LEMON_AI_SECRET_KEY=

# SaaS 多租户（登录时需要填写租户「硕米科技」）
LEMON_TENANT_ENABLED=false
# 演示模式：所有用户只能查看，不能新增、修改、删除
LEMON_DEMO_ENABLED=false
# 微信小程序（lemon-mp）的 AppID / AppSecret，不用小程序时留空
LEMON_MINIAPP_APP_ID=
LEMON_MINIAPP_APP_SECRET=
# 审批提醒的订阅消息模板 ID（字段名默认 thing1 标题、thing2 内容、time3 时间，不同时在 application.yml 中修改）
LEMON_MINIAPP_SUBSCRIBE_TEMPLATE_ID=

# 后端 JVM 内存
JAVA_OPTS=-Xms512m -Xmx1g

# 镜像名称与标签；发布脚本会给验证过的本地镜像加版本标签
IMAGE_PREFIX=shuomi-erp
IMAGE_TAG=latest

# 国内网络构建前端镜像时可指定 npm 镜像
NPM_REGISTRY=

# 本地基础服务镜像；生产只需要 Redis 镜像
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7-alpine
REDIS_DATABASE=0
