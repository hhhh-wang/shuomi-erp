# SHUOMI-ERP PRIVATE CUSTOMIZATION: production/local deployment
# 生产环境模板：复制为 docker/.env.prod，仅在服务器填写真实凭据。
# docker compose --env-file .env.prod -f docker-compose.prod.yml config --quiet
# .env.prod 必须限制读取权限，不要提交、打包或放入静态网站目录。

# 已导入的发布镜像：shuomi-erp-backend:<版本> 和 shuomi-erp-web:<版本>
IMAGE_PREFIX=shuomi-erp
IMAGE_TAG=
REDIS_IMAGE=redis:7-alpine

# 1Panel/OpenResty 终止 HTTPS，应用端口仅供反向代理使用。
# host 网络使用 127.0.0.1；桥接网络需填写代理容器能访问的宿主机网桥 IP。
WEB_BIND_IP=127.0.0.1
WEB_PORT=18080

# 独立腾讯云 MySQL，生产库为 shuomi-erp；Compose 中没有 MySQL 容器。
# nullCatalogMeansCurrent=true 限制 Flowable JDBC 元数据查询到当前库。
# 保持提供的 useSSL=true（Connector/J 优先尝试 SSL）。
# 云实例启用 SSL 并验证可用后，再增加 requireSSL=true；如有 CA，可配置 sslMode=VERIFY_IDENTITY。
DB_URL='jdbc:mysql://mysql.example.com:3306/shuomi-erp?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=GMT%2B8&nullCatalogMeansCurrent=true'
DB_USERNAME=
DB_PASSWORD=

REDIS_PASSWORD=
REDIS_DATABASE=0
# 建议用 openssl rand -base64 48 生成，JWT_SECRET 至少 32 字节。
JWT_SECRET=
# 可留空（使用 JWT_SECRET）；上线后保持稳定，否则已保存 AI API Key 需重新填写。
LEMON_AI_SECRET_KEY=
LEMON_TENANT_ENABLED=false
LEMON_DEMO_ENABLED=false
LEMON_MINIAPP_APP_ID=
LEMON_MINIAPP_APP_SECRET=
LEMON_MINIAPP_SUBSCRIBE_TEMPLATE_ID=
JAVA_OPTS=-Xms256m -Xmx768m

# 正常生产启动/更新关闭自动建表。首次部署必须先准备业务表及 Flowable ACT_ 表。
# 只有明确备份并完成升级审查后，才临时设置 true 执行 Flowable schema 创建/升级；完成即恢复 false。
FLOWABLE_DATABASE_SCHEMA_UPDATE=false
